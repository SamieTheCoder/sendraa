{
  "name": "sendraa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "zsh scripts/dev.sh",
    "mobile": "pnpm --filter @sendraa/mobile start",
    "mobile:ios": "pnpm --filter @sendraa/mobile ios",
    "mobile:android": "pnpm --filter @sendraa/mobile android",
    "api": "pnpm --filter @sendraa/api dev",
    "migrate": "pnpm --filter @sendraa/api migrate",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "pnpm -r --no-bail lint"
  }
}
