NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://sendraa:sendraa@localhost:54329/sendraa
BETTER_AUTH_URL=http://localhost:8787
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# From Cloudflare dashboard > Manage Account > OAuth clients (keep it private until launch).
# Redirect URL: <BETTER_AUTH_URL>/api/auth/oauth2/callback/cloudflare
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
APP_SCHEME=sendraa
# Local only: lets a password account create a workspace without Cloudflare.
ALLOW_DEV_ADMIN_SIGNUP=false
