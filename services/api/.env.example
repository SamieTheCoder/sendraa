NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://sendraa:sendraa@localhost:54329/sendraa
# Public HTTPS address of this API. Cloudflare redirects here after sign-in, so
# it must match a redirect URL on the OAuth client. In development a Cloudflare
# Tunnel gives localhost a stable HTTPS name (see README, "Cloudflare sign-in").
BETTER_AUTH_URL=https://api-dev.example.com
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# Filled in by `pnpm oauth:create`, or copied from
# Cloudflare dashboard > Manage Account > OAuth clients (keep it private until launch).
# Redirect URL: <BETTER_AUTH_URL>/api/auth/callback/cloudflare
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
APP_SCHEME=sendraa
# Web app origins allowed to call the API from a browser with the session cookie (comma-separated).
# A development API (NODE_ENV=development) also allows http(s)://localhost and 127.0.0.1 on any port.
WEB_ORIGINS=https://app.sendraa.tech
# Session cookies with SameSite=None, needed when the web app and API are different sites
# (localhost -> api-dev). Leave unset: on in development, off in production, where
# app.sendraa.tech and api.sendraa.tech are the same site.
# WEB_CROSS_SITE_COOKIES=
# Local only: lets a password account create a workspace without Cloudflare.
ALLOW_DEV_ADMIN_SIGNUP=false
# Token for the dev Cloudflare Tunnel, used by `pnpm tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# Account verification + password recovery. Server-only; never EXPO_PUBLIC_*.
# Gmail requires 2-Step Verification and an app password (not the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Enable only when the API origin is reachable exclusively through Cloudflare Tunnel.
TRUST_CLOUDFLARE_PROXY=false

# Native passkeys require a development/production build and domain association.
# RP ID must be the HTTPS API hostname (no scheme or path).
PASSKEY_RP_ID=
# Apple Team ID + '.' + bundle ID (from your signing account, not an invented value).
APPLE_APP_ID=
ANDROID_PACKAGE=com.scientificsamie.sendraa
# Comma-separated SHA-256 signing certificate fingerprints, colon-separated hex.
ANDROID_SHA256_FINGERPRINTS=
