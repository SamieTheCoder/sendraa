{
  "name": "@sendraa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sendraa/mail-worker build && tsx watch --env-file=.env src/index.ts",
    "start": "pnpm --filter @sendraa/mail-worker build && tsx --env-file=.env src/index.ts",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "mail:e2e": "tsx --env-file=.env scripts/mail-e2e.ts",
    "oauth:create": "tsx --env-file=.env scripts/create-oauth-client.ts",
    "tunnel": "sh -c 'set -a; . ./.env; set +a; TUNNEL_TOKEN=\"$CLOUDFLARE_TUNNEL_TOKEN\" exec cloudflared tunnel --no-autoupdate run'",
    "db:up": "sh scripts/db-up.sh",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:security": "tsx --env-file=.env scripts/security-test.ts",
    "test:sending": "tsx --env-file=.env scripts/sending-test.ts",
    "test:notifications": "tsx --env-file=.env scripts/invitations-push-test.ts",
    "test:provision": "tsx --env-file=.env scripts/provision-test.ts",
    "test:parsing": "tsx --env-file=.env scripts/parse-mail-test.ts",
    "test:accounts": "tsx --env-file=.env scripts/multi-session-test.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@hono/node-server": "2.1.5",
    "@sendraa/cloudflare": "workspace:*",
    "@sendraa/mail-worker": "workspace:*",
    "better-auth": "1.7.14",
    "hono": "4.13.16",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "postal-mime": "4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
